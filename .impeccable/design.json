:43%;width:35%;border-radius:0 4px 25% 0;transform:rotate(6deg);background:linear-gradient(180deg,#714633,#2d1e16 60%,#100e0c);box-shadow:3px 7px 3px #140c0d8f;z-index:-1}.ds-tail:before,.ds-tail:after{content:\"\";position:absolute;left:0;right:0;height:5px;background:repeating-linear-gradient(90deg,transparent 0 6px,#ba866c77 6px 11px,transparent 11px 17px)}.ds-tail:before{top:4px}.ds-tail:after{bottom:4px}"
    },
