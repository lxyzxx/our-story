  "narrative": {
    "northStar": "深夜的私人胶片工作台",
    "overview": "以「深夜的私人胶片工作台」为视觉北极星：暗酒红台面铺满视口，真实比例的 35 mm 胶卷是可操作的主角。炭黑金属、旧纸、暖金边缘与奶油文字在同一束柔光下形成温暖而克制的收藏感。\n\n文字像电影片头与器材铭牌，照片在观片器中保持内容优先。颗粒、投影与机械动作服务于物件的可信度；不引入粉色爱心、卡通情侣或 SaaS 卡片作为视觉语言。",
    "keyCharacteristics": [
      "满视口酒红台面与偏暗四角。",
      "奶油、橄榄、铁锈、炭黑四类胶卷纸标。",
      "细衬线电影标题与小字号器材标识并置。",
      "分层圆柱、齿孔底片与黄铜观片器构成实体入口。",
      "桌面、手机横屏与竖屏备用各自重排。"
    ],
    "rules": [
      {
        "name": "The Material Color Rule",
        "body": "色彩附着在台面、纸标、金属或底片等具体材料上；控件沿用暖中性色，不另建鲜艳按钮色。",
        "section": "colors"
      },
      {
        "name": "The Shared Light Rule",
        "body": "装饰物与可操作物共用受光方向；不要将投影当成无差别悬浮装饰。",
        "section": "elevation"
      }
    ],
    "dos": [
