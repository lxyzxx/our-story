NODE_ENV=production
# Set the Docker bridge gateway address reachable by the existing Caddy container.
# Use 127.0.0.1 if your reverse proxy runs directly on the host.
HOSTNAME=127.0.0.1
PORT=3010
ARCHIVE_CONTENT_FILE=/opt/our-story/shared/archive.json
NEXT_TELEMETRY_DISABLED=1
NODE_OPTIONS=--max-old-space-size=256
MALLOC_ARENA_MAX=2
